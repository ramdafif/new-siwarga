BACKUP_VERIFY_DATABASE_URL=mysql+pymysql://siwarga_backup_verify:CHANGE_ME@127.0.0.1:3306/siwarga_restore_test?charset=utf8mb4
BACKUP_DIRECTORY=/var/lib/siwarga/backups
BACKUP_LOCK=/var/lib/siwarga/maintenance.lock
BACKUP_METRICS=/var/lib/siwarga/metrics/backup.prom
RESTIC_REPOSITORY=sftp:backup@BACKUP_HOST:/backup/siwarga
RESTIC_PASSWORD_FILE=/etc/siwarga/restic-password
