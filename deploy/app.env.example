APP_ENV=production
SECRET_KEY=replace-with-at-least-32-random-characters
DATABASE_URL=mysql+pymysql://siwarga:CHANGE_ME@127.0.0.1:3306/siwarga_production?charset=utf8mb4
UPLOAD_FOLDER=/var/lib/siwarga/uploads
MAINTENANCE_LOCK=/var/lib/siwarga/maintenance.lock
SESSION_COOKIE_SECURE=true
LOGIN_RATE_LIMIT_BACKEND=redis
REDIS_URL=redis://:CHANGE_ME@127.0.0.1:6379/0
REDIS_NAMESPACE=siwarga:production
TRUSTED_HOSTS=siwarga.example.org
PROXY_HOPS=1
ENABLE_WEB_VITALS=true
PROFILE_REQUESTS=true
WEB_WORKERS=2
WEB_THREADS=2
