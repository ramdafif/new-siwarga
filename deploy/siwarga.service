[Unit]
Description=SiWarga Gunicorn application
After=network-online.target mysql.service redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=siwarga
Group=siwarga
WorkingDirectory=/srv/siwarga/current
EnvironmentFile=/etc/siwarga/app.env
Environment=PROMETHEUS_MULTIPROC_DIR=/run/siwarga/prometheus
Environment=PYTHONUNBUFFERED=1
RuntimeDirectory=siwarga
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/mkdir -p /run/siwarga/prometheus
ExecStart=/srv/siwarga/current/.venv/bin/gunicorn --config deploy/gunicorn.conf.py run:app
Restart=on-failure
RestartSec=5
TimeoutStopSec=75
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/siwarga /run/siwarga

[Install]
WantedBy=multi-user.target
